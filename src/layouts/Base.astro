---
import type { Locale } from '../i18n/config';
import { localeHtml, localizedPath, locales } from '../i18n/config';
import { t } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  pathname?: string;
}

const { locale, pathname = '/' } = Astro.props;
const dict = t(locale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://andresragot.github.io';
const canonical = site + (locale === 'es' ? '/' : `/${locale}/`);
const ogImage = `${site}/images/og-cover.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrés Ragot',
  url: site,
  jobTitle: 'Embedded Software Engineer',
  worksFor: { '@type': 'Organization', name: 'CipherBit — Grupo Oesía' },
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  knowsLanguage: ['es', 'en', 'fr'],
  sameAs: [
    'https://github.com/andresragot',
    'https://www.linkedin.com/in/andresragot/'
  ],
  knowsAbout: [
    'Firmware development', 'Embedded systems', 'ESP32', 'C++',
    'Real-time graphics', 'Software rendering', 'FreeRTOS', 'Game development'
  ]
};
---
<!doctype html>
<html lang={localeHtml[locale].slice(0,2)} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark light" />
  <title>{dict.meta.title}</title>
  <meta name="description" content={dict.meta.description} />
  <link rel="canonical" href={canonical} />
  {locales.map(l => (
    <link
      rel="alternate"
      hreflang={localeHtml[l].slice(0,2)}
      href={site + localizedPath(l)}
    />
  ))}
  <link rel="alternate" hreflang="x-default" href={site + '/'} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={localeHtml[locale]} />
  <meta property="og:title" content={dict.meta.title} />
  <meta property="og:description" content={dict.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={dict.meta.ogAlt} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={dict.meta.title} />
  <meta name="twitter:description" content={dict.meta.description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta name="theme-color" content="#0a0c10" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>

  <!-- Theme bootstrap (no flash) -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (!t) {
          t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>
  <slot name="header" />
  <main id="main">
    <slot />
  </main>
  <slot name="footer" />
  <button class="back-top" type="button" aria-label={dict.footer.backTop} data-back-top>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>

  <script>
    // Back-to-top visibility
    const btn = document.querySelector('[data-back-top]');
    if (btn) {
      const onScroll = () => {
        btn.classList.toggle('back-top--visible', window.scrollY > 600);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }
  </script>
</body>
</html>
