---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
const locale = 'es' as const;
const d = t(locale);
---
<Base locale={locale}>
  <Header slot="header" locale={locale} />
  <section style="min-height:60vh; display:flex; align-items:center;">
    <div class="container" style="text-align:center;">
      <p class="mono" style="color:var(--accent); letter-spacing:0.2em;">404</p>
      <h1>{d.notFound.title}</h1>
      <p class="muted">{d.notFound.desc}</p>
      <a class="btn btn--primary" href="/">{d.notFound.home}</a>
    </div>
  </section>
  <Footer slot="footer" locale={locale} />
</Base>
