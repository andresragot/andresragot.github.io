---
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { t } from '../i18n';
import { getCollection } from 'astro:content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);

const blogBase = locale === 'es' ? '/blog' : `/${locale}/blog`;
const posts = (await getCollection('blog', ({ data }) => data.locale === locale && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const localeIntl = locale === 'es' ? 'es-ES' : locale === 'fr' ? 'fr-FR' : 'en-US';
const fmtDate = (d: Date) => d.toLocaleDateString(localeIntl, { year: 'numeric', month: 'long', day: 'numeric' });
---
<section id="blog-list">
  <div class="container">
    <span class="eyebrow">{d.blog.heading}</span>
    <h1 class="section-title">{d.blog.heading}</h1>
    <p class="muted" style="max-width:60ch;">{d.blog.intro}</p>

    {posts.length === 0 ? (
      <p class="mono muted" style="margin-top:2rem;">{d.blog.empty}</p>
    ) : (
      <ul class="post-list">
        {posts.map(post => (
          <li class="post-list__item">
            <a href={`${blogBase}/${post.slug}/`} class="post-link">
              <time class="mono muted" datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
              <h2>{post.data.title}</h2>
              <p class="muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map(tag => <span class="tag mono">#{tag}</span>)}
                </div>
              )}
              <span class="post-readmore mono">{d.blog.readMore}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
