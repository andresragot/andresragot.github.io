---
import type { Locale } from '../i18n/config';
import { t } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const email = 'andresragot99@gmail.com';
---
<section id="contact">
  <div class="container">
    <span class="eyebrow">{d.contact.heading}</span>
    <p class="muted" style="max-width:55ch; margin-bottom: 1.5rem;">{d.contact.intro}</p>
    <div class="contact__grid">
      <div class="contact__card">
        <ul class="contact-list">
          <li>
            <a href={`mailto:${email}`} aria-label={`${d.contact.email}: ${email}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              <span class="mono">{email}</span>
            </a>
            <button class="copy-btn" type="button" data-copy={email} data-copy-label={d.contact.copy} data-copied-label={d.contact.copied}>
              {d.contact.copy}
            </button>
          </li>
          <li>
            <a href="https://github.com/andresragot" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.74-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 015.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.77.11 3.06.74.81 1.18 1.84 1.18 3.1 0 4.44-2.7 5.4-5.27 5.69.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
              <span>{d.contact.github}</span>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/andresragot/" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 11.01-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.72v20.56C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
              <span>{d.contact.linkedin}</span>
            </a>
          </li>
          <li>
            <a href="/cv/Andres_Ragot_CV.pdf" download>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3"/></svg>
              <span>{d.contact.cv}</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="contact__card">
        <pre class="mono" style="margin:0; color:var(--fg-muted); font-size:0.85rem; line-height:1.7; white-space:pre-wrap;">
<span style="color:var(--accent)">$</span> whoami
andres-ragot

<span style="color:var(--accent)">$</span> cat about.txt
Embedded SW Engineer.
Madrid · ES/EN/FR.

<span style="color:var(--accent)">$</span> echo $STATUS
ready to talk firmware.</pre>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy || '';
      try { await navigator.clipboard.writeText(value); } catch {}
      const original = btn.dataset.copyLabel || btn.textContent || 'Copy';
      const ok = btn.dataset.copiedLabel || 'Copied!';
      btn.textContent = ok;
      btn.dataset.copied = 'true';
      setTimeout(() => { btn.textContent = original; btn.dataset.copied = 'false'; }, 1800);
    });
  });
</script>
